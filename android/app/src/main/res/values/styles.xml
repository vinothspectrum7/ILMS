<resources>
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:statusBarColor">@color/brand_bg</item>
    <item name="android:navigationBarColor">@color/brand_bg</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:datePickerDialogTheme">@style/PickerDialogTheme</item>
    <item name="android:textColorPrimary">@color/brand_bg</item>
    <item name="android:textColorSecondary">@color/brand_bg</item>
  </style>
<style name="PickerDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
    <item name="colorPrimary">@color/brand_bg</item>
    <item name="colorPrimaryVariant">@color/brand_bg</item>
    <item name="colorAccent">@color/brand_bg</item>

    <!-- Calendar background -->
    <item name="android:windowBackground">#FFFFFF</item>
    <item name="colorSurface">@color/brand_bg</item>

    <!-- Text colors -->
    <item name="android:textColorPrimary">@color/brand_bg</item>
    <item name="android:textColorSecondary">@color/brand_bg</item>
</style>

</resources>
